---
import Heading from './Heading.astro';

const { t } = Astro.props;
const { services, process, business, home, about, faq } = t;
---
<section class="wrap block" id="services">
  <p class="eyebrow">{services.eyebrow}</p>
  <Heading title={services.title} />
  <div class="services">
    {services.list.map((s) => (
      <article class:list={['service', { featured: s.featured }]}>
        <div>
          <h3>{s.title}</h3>
          <p>{s.lead}</p>
        </div>
        <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
      </article>
    ))}
  </div>
</section>

<section class="wrap block" id="process">
  <p class="eyebrow">{process.eyebrow}</p>
  <Heading title={process.title} />
  <ol class="steps">
    {process.steps.map(([title, text], i) => (
      <li>
        <span class="number" aria-hidden="true">{i + 1}</span>
        <h3>{title}</h3>
        <p>{text}</p>
      </li>
    ))}
  </ol>
</section>

<section class="wrap block" id="business">
  <p class="eyebrow">{business.eyebrow}</p>
  <Heading title={business.title} />
  <p class="intro">{business.intro}</p>
  <dl class="packages">
    {business.packages.map(([name, size, text]) => (
      <div>
        <dt>{business.packageLabel(name)} <small>{size}</small></dt>
        <dd>{text}</dd>
      </div>
    ))}
  </dl>
  <div class="table">
    <table>
      <thead>
        <tr><th scope="col">{business.tableHead}</th>{business.packages.map(([name]) => <th scope="col">{name}</th>)}</tr>
      </thead>
      <tbody>
        {business.features.map(([label, ...values]) => (
          <tr>
            <th scope="row">{label}</th>
            {values.map((v) => (
              <td>
                {v === true ? <span role="img" aria-label={business.included}>✓</span>
                  : v === false ? <span role="img" aria-label={business.excluded}>—</span>
                  : v}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul class="notes">{business.notes.map((n) => <li>{n}</li>)}</ul>
  <p>{business.custom}</p>
  <a class="button" href="#request">{business.cta}</a>
</section>

<section class="wrap block">
  <div class="home">
    <p class="eyebrow">{home.eyebrow}</p>
    <Heading title={home.title} />
    <p>{home.text}</p>
    <a class="button" href="#request">{home.cta}</a>
  </div>
</section>

<section class="wrap block split" id="about">
  <div>
    <p class="eyebrow">{about.eyebrow}</p>
    <Heading title={about.title} />
    <p class="person"><strong>{about.name}</strong>, CEO<br />{about.experience}</p>
  </div>
  <div class="story">
    <h3>{about.storyTitle}</h3>
    {about.story.map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="wrap block split" id="faq">
  <div class="sticky"><Heading title={faq.title} /></div>
  <div>
    {faq.list.map(([q, a]) => (
      <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .block { padding-block: 40px; scroll-margin-top: 16px; }
  .eyebrow { margin: 0 0 16px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; }
  h3 {
    margin: 0 0 8px;
    color: var(--ink);
    font: 500 24px/1.3 var(--font-sub);
    letter-spacing: -0.01em;
  }

  .service {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 64px;
    padding-block: 32px;
    border-bottom: 1px solid var(--cream);
  }
  .service p, .service ul { margin: 0; }
  .service ul { padding-left: 20px; }
  .featured {
    padding: 32px;
    border: 0;
    border-radius: 16px;
    background: var(--ink);
    color: var(--paper);
  }
  .featured h3 { color: var(--paper); }
  .service:not(.featured) { padding-inline: 32px; }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding: 32px;
    border: 1px solid var(--cream);
    border-radius: 16px;
    background: var(--paper);
  }
  .steps li:first-child { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .steps li:first-child h3 { color: var(--paper); }
  .steps li:last-child { border: 1.5px solid var(--cobalt); }
  .steps p { margin: 0; }
  .number {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-bottom: 24px;
    border-radius: 16px;
    background: var(--lavender);
    color: var(--ink);
    font-weight: 700;
  }

  .intro { margin: -8px 0 32px; font-size: 18px; }
  .packages { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 0 0 24px; }
  .packages div { padding: 24px; border: 1px solid var(--cream); border-radius: 16px; background: var(--paper); }
  dt { color: var(--ink); font: 500 20px/1.4 var(--font-sub); }
  dt small { display: block; color: var(--charcoal); font: 400 14px/1.6 var(--font-body); }
  dd { margin: 12px 0 0; }
  .table { overflow: hidden; border: 1px solid var(--cream); border-radius: 16px; background: var(--paper); }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { padding: 14px 16px; border-bottom: 1px solid var(--cream); text-align: center; }
  tr > :first-child { width: 40%; text-align: left; }
  tbody th { font-weight: 400; }
  tbody tr:last-child > * { border-bottom: 0; }
  .notes { padding-left: 20px; }

  .home { padding: 48px; border-radius: 24px; background: var(--lavender); }
  .home :global(h2) { margin-bottom: 16px; }
  .home p:not(.eyebrow) { max-width: 40em; margin: 0 0 24px; }

  .split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 24px 64px; align-items: start; }
  .person { font-size: 18px; }
  .story { padding: 32px; border: 1px solid var(--cream); border-radius: 16px; background: var(--paper); }
  .story p:last-child { margin-bottom: 0; }
  .sticky { position: sticky; top: 24px; }
  details { border-bottom: 1px solid var(--cream); border-radius: 16px; background: var(--paper); margin-bottom: 8px; padding-inline: 24px; }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--graphite); font-size: 20px; line-height: 1.2; }
  details[open] summary::after { content: '−'; }
  details p { margin: 0; padding-bottom: 24px; }

  @media (max-width: 860px) {
    .service, .steps, .packages, .split { grid-template-columns: 1fr; }
    .service:not(.featured) { padding-inline: 0; }
    .featured, .steps li, .story { padding: 24px; }
    .home { padding: 32px 24px; }
    .sticky { position: static; }
    .sticky :global(h2) { margin-bottom: 0; }
  }
  @media (max-width: 560px) {
    table { font-size: 12px; line-height: 1.4; }
    th, td { padding: 10px 4px; overflow-wrap: break-word; }
    tr > :first-child { width: 37%; padding-left: 10px; }
  }
</style>
