---
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const anchors = ['#services', '#process', '#business', '#about', '#faq'];
const languages = [
  ['uk', `${base}/`, 'UA'],
  ['en', `${base}/en/`, 'EN'],
];
---
<header class="wrap header">
  <a class="logo" href={languages.find(([id]) => id === t.lang)[1]}>
    <img src={`${base}/icon.svg`} alt="" width="32" height="40" />
    <span>RAPACH IT</span>
  </a>
  <nav class="menu" aria-label={t.header.menu}>
    {anchors.map((href, i) => <a href={href}>{t.header.nav[i]}</a>)}
  </nav>
  <div class="end">
    <nav class="languages" aria-label={t.header.language}>
      {languages.map(([id, href, label]) => (
        <a href={href} lang={id} hreflang={id} aria-current={id === t.lang ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <a class="button" href="#request">{t.header.cta}</a>
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font: 700 19px/1 var(--font-sub);
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo img { width: 32px; height: 36px; object-fit: contain; }
  .menu { display: flex; gap: 24px; }
  .menu a {
    color: var(--graphite);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .menu a:hover { color: var(--cobalt); }
  .end { display: flex; align-items: center; gap: 16px; }
  .languages { display: flex; }
  .languages a {
    padding: 4px 8px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }
  .languages a[aria-current] { background: var(--lavender); color: var(--ink); }
  @media (max-width: 1060px) {
    .menu { display: none; }
  }
  /* On phones the request button lives in the bottom bar. */
  @media (max-width: 600px) {
    .header .button { display: none; }
  }
</style>
