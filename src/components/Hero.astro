---
import mark from '../data/mark.json';
import { contacts } from '../data/contacts.js';

const { t } = Astro.props;
---
<section class="wrap hero">
  <div>
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.title} <em><span class="nowrap">{t.hero.accent[0]}</span> <span class="nowrap">{t.hero.accent[1]}</span></em></h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="actions">
      <a class="button" href="#request">{t.hero.cta}</a>
      {contacts.telegram && (
        <a class="secondary" href={`https://t.me/${contacts.telegram}`}>{t.hero.telegram}</a>
      )}
    </div>
  </div>

  <div class="visual">
    <div class="card-back" aria-hidden="true"></div>
    <div class="card">
      <svg viewBox={mark.viewBox} role="img" aria-label={t.hero.markLabel}>
        <path d={mark.bird} fill-rule="evenodd" />
        {mark.arcs.map((d, i) => <path class="arc" style={`--i:${i}`} d={d} />)}
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 64px;
    padding-block: 64px 96px;
  }
  .eyebrow {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(clamp(40px, 5.4vw, 64px) * var(--display-scale));
    font-weight: 400;
    line-height: 1.07;
    text-wrap: balance;
  }
  h1 em { color: var(--ink); }
  .nowrap { white-space: nowrap; }
  .lead {
    max-width: 34em;
    margin: 24px 0 32px;
    font-size: 18px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .secondary {
    color: var(--graphite);
    font-weight: 500;
    text-underline-offset: 5px;
  }
  .visual {
    position: relative;
    width: 100%;
    max-width: 460px;
    justify-self: end;
  }
  .card, .card-back {
    border-radius: 24px;
    aspect-ratio: 1;
  }
  .card-back {
    position: absolute;
    inset: 0;
    background: var(--lavender);
    transform: rotate(5deg);
  }
  .card {
    position: relative;
    display: grid;
    place-items: center;
    padding: 11%;
    background: var(--ink);
  }
  svg {
    width: 100%;
    height: 100%;
    fill: var(--paper);
  }
  /* One moment of motion: the call travels outward from the beak. */
  @media (prefers-reduced-motion: no-preference) {
    .arc {
      animation: call 0.5s ease-out both;
      animation-delay: calc(0.5s + var(--i) * 0.22s);
    }
    @keyframes call {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 56px;
      padding-block: 32px 64px;
    }
    .visual {
      max-width: 340px;
      justify-self: center;
      width: calc(100% - 24px);
    }
  }
</style>
