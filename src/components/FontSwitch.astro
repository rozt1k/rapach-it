---
// Temporary: compares the two headline fonts. Delete after the choice is made.
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const options = [
  ['source', `${base}/`, 'А: Source Serif 4'],
  ['garamond', `${base}/garamond/`, 'Б: EB Garamond'],
];
---
<aside aria-label="Варіанти шрифту">
  {options.map(([id, href, label]) => (
    <a href={href} aria-current={id === current ? 'page' : undefined}>{label}</a>
  ))}
</aside>

<style>
  aside {
    position: fixed;
    bottom: 76px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 100px;
    background: var(--paper);
    white-space: nowrap;
  }
  a {
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
  }
  a[aria-current] { background: var(--ink); color: var(--paper); }
</style>
