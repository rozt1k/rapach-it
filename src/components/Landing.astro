---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Sections from './Sections.astro';
import Contact from './Contact.astro';

const { t } = Astro.props;
---
<Base t={t}>
  <Header t={t} />
  <main>
    <Hero t={t} />
    <Sections t={t} />
  </main>
  <Contact t={t} />
</Base>
